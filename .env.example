BOT_TOKEN=
# Telegram ID владельцев через запятую, например 111111111,222222222
OWNER_TELEGRAM_IDS=
DATABASE_URL=postgresql+asyncpg://debtbot:debtbot@db:5432/debtbot
REDIS_URL=redis://redis:6379/0
TZ=Europe/Moscow
LOG_LEVEL=INFO

# Необязательно: ID группы, куда бот публикует новые записи, отмены, корректировки кассы и
# события помощников, например -1001234567890. Добавьте бота в группу: владельцу придёт личное
# сообщение с готовой строкой. Оставьте пустым, если уведомления в группу не нужны.
GROUP_CHAT_ID=

# Необязательно: прокси до api.telegram.org, если Telegram заблокирован у провайдера.
# Поддерживаются http://, https://, socks4://, socks5://, например socks5://user:pass@1.2.3.4:1080.
# Оставьте пустым, если сервер напрямую достаёт до Telegram. Для запуска в России есть ветка
# ru_version с готовым клиентом Hysteria2.
PROXY_URL=
