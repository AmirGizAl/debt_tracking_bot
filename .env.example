BOT_TOKEN=
# Telegram ID владельцев через запятую, например 111111111,222222222
OWNER_TELEGRAM_IDS=
DATABASE_URL=postgresql+asyncpg://debtbot:debtbot@db:5432/debtbot
REDIS_URL=redis://redis:6379/0
TZ=Europe/Moscow
LOG_LEVEL=INFO

# Необязательно: ID группы, куда бот публикует новые записи, отмены, корректировки, итог
# закрытия дня и события помощников, например -1001234567890. Добавьте бота в группу: владельцу
# придёт личное сообщение с готовой строкой. Оставьте пустым, если уведомления в группу не нужны.
GROUP_CHAT_ID=

# Прокси до api.telegram.org: клиент Hysteria2 из docker-compose.yml (ветка ru_version).
# Настройка клиента: hysteria/config.yaml (пример в hysteria/config.example.yaml).
PROXY_URL=socks5://hysteria:1080
